# ============ Telegram ============
BOT_TOKEN=
BOT_USERNAME=FuckingCoolAIbot
ALLOWED_GROUP_IDS=
ADMIN_IDS=
LEARN_GROUP_ID_MODE=0

# ============ AI providers: text pool (free-tier-first) ============
# IMPORTANT: these defaults target providers/models that can be used on free tiers,
# but the bot cannot detect or enforce your provider billing plan. If your Groq,
# Cloudflare, Gemini, or B.AI account is on a paid tier, provider-side charges may apply.
# B.AI's zero-credit models are promotional and can change; B.AI is opt-in here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
BAI_API_KEY=
BAI_TEXT_MODEL=qwen3.8-flash
BAI_REQUEST_TIMEOUT_SEC=30.0
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/zai-org/glm-4.7-flash
# Add `bai` explicitly when you want to enable B.AI, e.g. groq,bai,cloudflare,openrouter,gemini.
TEXT_PROVIDER_ORDER=groq,cloudflare,openrouter,gemini

# ============ Vision input (image understanding only) ============
# Rollback switch: set 0 to disable all image requests without changing text flow.
VISION_ENABLED=1
GEMINI_VISION_MODEL=gemini-3.8-flash
GROQ_VISION_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b
CLOUDFLARE_VISION_MODEL=@cf/google/gemma-4-26b-a4b-it
BAI_VISION_MODEL=qwen3.8-flash
# B.AI vision is rollout-capped at 1 image/request until multi-image compatibility is verified.
# Add `bai` explicitly when you want to enable it, e.g. groq_qwen38,cloudflare,bai,groq_qwen36,gemini.
VISION_PROVIDER_ORDER=groq_qwen38,cloudflare,groq_qwen36,gemini
MAX_IMAGES_PER_REQUEST=3
MAX_IMAGE_BYTES=8388608
MAX_TOTAL_IMAGE_BYTES=12582912

# ============ Web + image search ============
# auto = prefer self-hosted SearXNG for both web and image search, then fallback DDGS.
# Alternatives: searxng | ddgs
SEARCH_BACKEND=auto
SEARXNG_URL=http://searxng:8080
IMAGE_SEARCH_MAX_RESULTS=4
# Specialized X/Twitter status reader: FxTwitter v2 -> X oEmbed -> generic reader.
# No API key required. Set 0 to rollback to the generic reader only.
X_FETCH_ENABLED=1
SEARXNG_IMAGE=
GRANIAN_BLOCKING_THREADS=1
GRANIAN_BACKPRESSURE=2

# ============ Giới hạn sử dụng / tiết kiệm quota ============
MAX_QUESTIONS_PER_MIN_PER_USER=3
MAX_CONTEXT_TURNS=6
MAX_TOOL_ROUNDS=2
REQUEST_TIMEOUT_SEC=60.0
QUESTION_TIMEOUT_SEC=180.0
LOG_LEVEL=INFO
