# ============ Telegram ============
BOT_TOKEN=
BOT_USERNAME=FuckingCoolAIbot
ALLOWED_GROUP_IDS=
ADMIN_IDS=
LEARN_GROUP_ID_MODE=0

# ============ AI providers: text pool (free-tier-first) ============
# IMPORTANT: NVIDIA hosted free/trial endpoints are for development/testing/prototyping;
# do not treat them as production entitlement. For production, use an appropriate
# NVIDIA commercial/self-hosted entitlement or remove nvidia from TEXT_PROVIDER_ORDER.
# The bot cannot detect or enforce your provider billing/licensing plan.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TEXT_MODEL=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_NIM_VISION_MODEL=google/gemma-4-31b-it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/zai-org/glm-4.7-flash
TEXT_PROVIDER_ORDER=nvidia,groq,cloudflare,openrouter,gemini

# ============ Vision input (image understanding only) ============
# Rollback switch: set 0 to disable all image requests without changing text flow.
# NVIDIA vision is intentionally opt-in: add `nvidia` to VISION_PROVIDER_ORDER only
# after validating your selected NIM vision model and deployment entitlement.
VISION_ENABLED=1
GEMINI_VISION_MODEL=gemini-3.8-flash
GROQ_VISION_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b
CLOUDFLARE_VISION_MODEL=@cf/google/gemma-4-26b-a4b-it
VISION_PROVIDER_ORDER=groq_qwen38,cloudflare,groq_qwen36,gemini
MAX_IMAGES_PER_REQUEST=3
MAX_IMAGE_BYTES=8388608
MAX_TOTAL_IMAGE_BYTES=12582912

# ============ Web + image search ============
# auto = prefer self-hosted SearXNG for both web and image search, then fallback DDGS.
# Alternatives: searxng | ddgs
SEARCH_BACKEND=auto
SEARXNG_URL=http://searxng:8080
IMAGE_SEARCH_MAX_RESULTS=4
# Specialized X/Twitter status reader: FxTwitter v2 -> X oEmbed -> generic reader.
# No API key required. Set 0 to rollback to the generic reader only.
X_FETCH_ENABLED=1
SEARXNG_IMAGE=
GRANIAN_BLOCKING_THREADS=1
GRANIAN_BACKPRESSURE=2

# ============ Giới hạn sử dụng / tiết kiệm quota ============
MAX_QUESTIONS_PER_MIN_PER_USER=3
MAX_CONTEXT_TURNS=6
MAX_TOOL_ROUNDS=2
REQUEST_TIMEOUT_SEC=60.0
QUESTION_TIMEOUT_SEC=180.0
LOG_LEVEL=INFO
