# ============ Telegram ============
BOT_TOKEN=
BOT_USERNAME=FuckingCoolAIbot
ALLOWED_GROUP_IDS=
ADMIN_IDS=
LEARN_GROUP_ID_MODE=0

# ============ AI providers ============
# Chainnode is the production primary. Pools preserve case and use left-to-right priority.
# Ordering is model-major then credential: model1/key1, model1/key2, model2/key1...
CHAINNODE_API_KEYS=
CHAINNODE_BASE_URL=https://dn.chainno.de/v1
CHAINNODE_TEXT_MODELS=cl/cline-free/deepseek-v4.1-flash
CHAINNODE_VISION_MODELS=cl/cline-free/muse-spark-1.3-contributor
# Per-HTTP-attempt read timeout; QUESTION_TIMEOUT_SEC is the outer question deadline.
CHAINNODE_REQUEST_TIMEOUT_SEC=60.0

# xKiro ordering is model-major then credential: model1/key1, model1/key2, model2/key1...
XKIRO_API_KEYS=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_TEXT_MODELS=
XKIRO_VISION_MODELS=
XKIRO_REQUEST_TIMEOUT_SEC=60.0

TEXT_PROVIDER_ORDER=chainnode,xkiro
# Request-scoped transport retry bounds. Provider success resets only the consecutive
# failure streak; cumulative budgets and a consumed same-provider retry remain monotonic.
PROVIDER_RETRY_MAX_CONSECUTIVE=2
PROVIDER_RETRY_MAX_PER_PROVIDER=3
PROVIDER_RETRY_MAX_PER_REQUEST=5
# Separate bounded budget for quota/auth/model resource recovery across concrete targets.
PROVIDER_RECOVERY_MAX_HOPS_PER_REQUEST=5

# ============ Vision input (image understanding only) ============
# Rollback switch: set 0 to disable all image requests without changing text flow.
VISION_ENABLED=1
VISION_PROVIDER_ORDER=chainnode,xkiro
# Runtime and both current provider slots remain capped at one image per request.
MAX_IMAGES_PER_REQUEST=1
MAX_IMAGE_BYTES=8388608
MAX_TOTAL_IMAGE_BYTES=12582912

# ============ Web + image search ============
# auto = SearXNG primary, DDGS fallback; no ping-pong retry in the same request.
# Web: 1 usable SearXNG result is topped up from DDGS; 2+ results return immediately.
# Images: 1 usable SearXNG result is enough and does not trigger DDGS top-up.
# Alternatives: searxng | ddgs (strict single-backend modes).
SEARCH_BACKEND=auto
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT_SEC=7.0
DDGS_TIMEOUT_SEC=8.0
SEARCH_TOTAL_TIMEOUT_SEC=15.0
SEARCH_CIRCUIT_FAILURE_THRESHOLD=3
SEARCH_CIRCUIT_COOLDOWN_SEC=30.0
SEARCH_RATE_LIMIT_COOLDOWN_SEC=180.0
SEARCH_CACHE_MAX_ENTRIES=256
SEARCH_WEB_CACHE_TTL_SEC=60.0
SEARCH_IMAGE_CACHE_TTL_SEC=120.0
SEARCH_STALE_CACHE_TTL_SEC=900.0
IMAGE_SEARCH_MAX_RESULTS=4
# Specialized X/Twitter status reader: FxTwitter v2 -> X oEmbed -> generic reader.
# No API key required. Set 0 to rollback to the generic reader only.
X_FETCH_ENABLED=1
# Keep the deploy reproducible. Bump deliberately after testing a newer SearXNG image.
SEARXNG_IMAGE=ghcr.io/searxng/searxng:2026.9.7-3e454637f
GRANIAN_BLOCKING_THREADS=1
GRANIAN_BACKPRESSURE=2

# ============ URL reading / Crawl4AI ============
# URL reader acceleration/rendering. 0 = instant rollback to existing generic reader.
CRAWL4AI_ENABLED=1
CRAWL4AI_URL=http://crawl4ai:11235
# Generate a strong random secret (for example: openssl rand -hex 32).
# Share it only between the bot and the private Crawl4AI container.
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT_SEC=25.0
CRAWL4AI_MAX_CHARS=12000
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.3
CRAWL4AI_SHM_SIZE=512m

# ============ Giới hạn sử dụng / tiết kiệm quota ============
MAX_QUESTIONS_PER_MIN_PER_USER=3
MAX_CONTEXT_TURNS=6
MAX_TOOL_ROUNDS=2
REQUEST_TIMEOUT_SEC=60.0
# Outer hard deadline for the entire end-user question, including retries/tools/fallback.
QUESTION_TIMEOUT_SEC=180.0
LOG_LEVEL=INFO

# Renewable jobs: opt in after offline tests and operator smoke; RAM only.
QUESTION_CONTROLS_ENABLED=0
QUESTION_RENEWAL_INTERVAL_SEC=180
QUESTION_PROGRESS_INTERVAL_SEC=25
QUESTION_MAX_INFLIGHT_OPERATIONS=2
QUESTION_MAX_PENDING_JOBS=20
QUESTION_MAX_JOBS_PER_USER=2
AI_ATTEMPT_TOTAL_TIMEOUT_SEC=90
URL_READ_TOTAL_TIMEOUT_SEC=40
TOOL_CALL_TOTAL_TIMEOUT_SEC=45
