# ============ Telegram ============
# Token bot lấy từ @BotFather
BOT_TOKEN=
# Username bot (không cần dấu @). TÙY CHỌN — khi khởi động bot tự lấy username
# thật từ Telegram (getMe), nên không cần chỉnh trừ khi muốn đặt fallback.
BOT_USERNAME=FuckingCoolAIbot
# chat_id các group được phép (dấu phẩy), vd: -1001234567890,-1009876543210
ALLOWED_GROUP_IDS=
# user_id admin (dấu phẩy) — có quyền /status
ADMIN_IDS=
# Lần đầu chạy đặt =1 để bot KHÔNG rời group lạ mà chỉ log chat_id (mục README)
LEARN_GROUP_ID_MODE=0

# ============ AI providers (free) ============
# Google AI Studio: https://aistudio.google.com/apikey  (bắt buộc tối thiểu 1 key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq: https://console.groq.com/keys  (khuyến nghị — fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter: https://openrouter.ai/keys (tùy chọn — fallback cuối)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============ Web search ============
# ddgs (mặc định, không key) | searxng (tự host) | tavily (free 1000 credit/tháng)
SEARCH_BACKEND=ddgs
# Chỉ cần khi SEARCH_BACKEND=searxng (chạy kèm docker compose --profile searxng):
# bot gọi nội bộ service searxng qua Docker network (container không publish port ra ngoài).
SEARXNG_URL=http://searxng:8080
# Khuyến nghị pin image theo tag ngày khi production; để trống dùng mặc định trong compose.
SEARXNG_IMAGE=
# Không cần thêm biến SEARXNG_SECRET/SEARXNG_BIND_IP/SEARXNG_LIMITER/... :
# SearXNG chạy private chỉ cho bot (không public) — secret_key đặt trong
# searxng/settings.yml (xem DEPLOY_SEARXNG_VPS.md), không có valkey/limiter/reverse proxy.

# Chỉ cần khi SEARCH_BACKEND=tavily
TAVILY_API_KEY=

# ============ Giới hạn sử dụng ============
MAX_QUESTIONS_PER_MIN_PER_USER=3
MAX_CONTEXT_TURNS=10
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT_SEC=60.0
LOG_LEVEL=INFO
