# ============ Telegram ============
# Token bot lấy từ @BotFather
BOT_TOKEN=
# Username bot (không cần dấu @). TÙY CHỌN — khi khởi động bot tự lấy username
# thật từ Telegram (getMe), nên không cần chỉnh trừ khi muốn đặt fallback.
BOT_USERNAME=FuckingCoolAIbot
# chat_id các group được phép (dấu phẩy), vd: -1001234567890,-1009876543210
ALLOWED_GROUP_IDS=
# user_id admin (dấu phẩy) — có quyền /status
ADMIN_IDS=
# Lần đầu chạy đặt =1 để bot KHÔNG rời group lạ mà chỉ log chat_id (mục README)
LEARN_GROUP_ID_MODE=0

# ============ AI providers (free) ============
# Google AI Studio: https://aistudio.google.com/apikey  (bắt buộc tối thiểu 1 key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq: https://console.groq.com/keys  (khuyến nghị — fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter: https://openrouter.ai/keys (tùy chọn — fallback cuối)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============ Web search ============
# ddgs (mặc định, không key) | searxng (tự host) | tavily (free 1000 credit/tháng)
SEARCH_BACKEND=ddgs
# Chỉ cần khi SEARCH_BACKEND=searxng (chạy kèm docker compose --profile searxng)
# Bot sẽ gọi nội bộ service searxng qua Docker network.
SEARXNG_URL=http://searxng:8080
# Production trên VPS: nếu có reverse proxy/domain cho SearXNG, điền URL public tại đây.
# Ví dụ: https://search.example.com/
SEARXNG_BASE_URL=
# BẮT BUỘC đổi khi bật profile searxng: openssl rand -hex 32
SEARXNG_SECRET=
# Khuyến nghị pin image theo tag cụ thể khi production; để trống sẽ dùng mặc định trong compose.
SEARXNG_IMAGE=
SEARXNG_VALKEY_IMAGE=
# Mặc định chỉ bind ra loopback của VPS để reverse proxy local truy cập.
SEARXNG_BIND_IP=127.0.0.1
SEARXNG_HOST_PORT=18080
# false cho bot-only/internal; true chỉ khi SearXNG nhận traffic thật từ browser/người dùng.
SEARXNG_LIMITER=false
SEARXNG_PUBLIC_INSTANCE=false
SEARXNG_IMAGE_PROXY=false
# Override nếu cần; mặc định compose sẽ dùng valkey://searxng-valkey:6379/0
SEARXNG_VALKEY_URL=
# Chỉ cần khi SEARCH_BACKEND=tavily
TAVILY_API_KEY=

# ============ Giới hạn sử dụng ============
MAX_QUESTIONS_PER_MIN_PER_USER=3
MAX_CONTEXT_TURNS=10
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT_SEC=60.0
LOG_LEVEL=INFO
